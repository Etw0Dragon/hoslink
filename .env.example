# Copier dans .env.node (ne pas écraser l’ancien .env Go).
NODE_ENV=development
PORT=8080
BASE_URL=http://localhost:8080
# Mot de passe hexadécimal conseillé pour éviter l’encodage URL.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
DATABASE_URL=postgres://hoslink:REPLACE_WITH_RANDOM_HEX@localhost:55432/hoslink_node
TEST_DATABASE_URL=postgres://hoslink:REPLACE_WITH_RANDOM_HEX@localhost:55432/hoslink_ts_test
BETTER_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
MAIL_DIR=var/mail
MAIL_FROM=noreply@hoslink.tmfolio.site
# SMTP_URL à OMETTRE en développement pour écrire les emails dans MAIL_DIR.
# SMTP_URL=smtps://user:encoded-password@smtp.example.com:465
